# --- Server identity / network ---
INSTANCE_ID=inst-1
PORT=3000
HOST=0.0.0.0

# --- Redis pub/sub (fan-out across instances) ---
REDIS_URL=redis://127.0.0.1:6379
CHANNEL=events            # pub/sub channel the producer publishes to and servers subscribe to

# --- Event producer (rate R, payload size) ---
RATE=10                   # events per second
PAYLOAD_BYTES=200         # approx serialized bytes per event (envelope + padding)
TOPIC=events

# --- Per-instance event buffer (serves poll/longpoll + reconnect resync) ---
BUFFER_SIZE=10000         # ring buffer capacity in events; slow pollers that fall off this = "missed"

# --- Polling ---
POLL_MAX_BATCH=1000       # max events returned per poll response

# --- Adaptive / debounced poll hints (server-driven backoff) ---
POLL_MIN_MS=50            # poll interval when events are flowing
POLL_MAX_MS=5000          # ceiling when idle
POLL_BACKOFF=2            # exponential backoff factor per consecutive empty poll

# --- Long poll ---
LONGPOLL_TIMEOUT_MS=25000 # hold the request open this long before returning empty (keep < 60s headersTimeout)

# --- Heartbeats / keepalive ---
SSE_HEARTBEAT_MS=15000
WS_HEARTBEAT_MS=15000

# --- Backpressure ---
WS_MAX_BUFFERED_BYTES=1048576   # if ws.bufferedAmount exceeds this, count backpressure (and skip send)

# --- Dev convenience only (keep 0 for benchmarks so producer CPU does NOT pollute server CPU) ---
EMBED_PRODUCER=0
